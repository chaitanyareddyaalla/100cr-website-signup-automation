# Local development defaults. Copy to .env and replace values for your environment.
APP_ENV=development
AUTOMATION_MODE=mock
# ENVIRONMENT is supported only as a legacy fallback. Do not use it for new deployments.
DATABASE_URL=postgresql+psycopg://task_automation:change-me@localhost:5432/task_automation
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
AUTH_REQUIRED=false
API_RATE_LIMIT_PER_MINUTE=100
FRONTEND_ORIGIN=http://localhost:5173
MAX_WORKERS=2
MAX_SIGNUP_RETRIES=3
LOG_LEVEL=INFO
AUTHORIZED_TEST_BASE_URL=
# Optional: enable export of authorized workflow results to Google Sheets
GOOGLE_SHEETS_ID=your-spreadsheet-id
GOOGLE_SHEETS_WORKSHEET=Results
GOOGLE_SERVICE_ACCOUNT_JSON=C:\\secure\\google-service-account.json
